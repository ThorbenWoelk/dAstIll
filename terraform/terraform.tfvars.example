project_id          = "dastill"
region              = "europe-west3"
app_name            = "dastill"
firestore_location_id = "eur3"
firebase_web_app_display_name = "dAstIll Web"
aws_region          = "eu-central-1"

# Project-scoped Google API key from the target GCP project. Rotate this during
# project migrations; a key from the previous project can still exist but fail
# if YouTube Data API v3 is disabled there.
youtube_api_key     = "your-youtube-api-key"
ollama_api_key      = "your-ollama-api-key"
logfire_token       = "your-logfire-token"
backend_proxy_token = "replace-with-a-long-random-proxy-token"
# Optional: set to let Terraform create a Secret Manager version for the backend Turso token.
# The TURSO_DB_URL env var is set inline in .github/workflows/deploy.yml.
# turso_auth_token = "your-turso-auth-token"

# Google sign-in is configured in frontend/firebase.json and deployed with Firebase Auth.

# Optional: set to let Terraform store the PAT; omit or "" if the secret already exists in GCP.
# databricks_token = "your-databricks-personal-access-token"

# Optional: enable Terraform-managed prerequisites for Cloud Billing export to BigQuery.
# This creates the dataset and grants the Google-managed billing export writers access.
# The final export toggle still happens in Cloud Billing after `terraform apply`.
# billing_export_enabled = true
# billing_export_project_id = "your-gcp-project-id"
# billing_export_dataset_id = "billing_export"
# billing_export_dataset_location = "EU"

# github_wif_pool_id = "github-pool-v1"
# github_wif_provider_id = "github-provider-v1"
# github_repository = "ThorbenWoelk/dAstIll"

ollama_url              = "https://your-ollama-proxy.com"
ollama_summary_model    = "glm-5.1:cloud"
ollama_default_chat_model = "glm-5.1:cloud"
summary_evaluator_model = "glm-5.1:cloud"
ollama_fallback_model   = "qwen3-coder:30b"
ollama_embedding_model  = "embeddinggemma:latest"
