# Frontend env for local development and static builds.
# `./scripts/link_shared_env.sh` copies this file to `~/.config/dastill/frontend.env`.
# `VITE_` and `PUBLIC_` values are exposed to browser code by Vite/SvelteKit.

# Backend API base URL used by local dev and Tauri Android fallback flows.
VITE_API_BASE=http://localhost:3544

# Backend API base URL required for hosted static builds.
PUBLIC_API_BASE=http://localhost:3544

# Docs site URL used by the product app header and maintenance page.
PUBLIC_DOCS_URL=http://localhost:4173

# Firebase Web API key from Firebase project settings.
PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key

# Firebase Auth domain for browser sign-in.
PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com

# Firebase project id used by the frontend Firebase client.
PUBLIC_FIREBASE_PROJECT_ID=your-project-id

# Optional Firebase Auth emulator host for local auth tests.
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Optional contact email shown in anonymous chat quota and maintenance surfaces.
# PUBLIC_CONTACT_EMAIL=hello@example.com

# Optional support link used on the maintenance page.
PUBLIC_SUPPORT_URL=https://buy.stripe.com/00w00c5OM6rG3IQe5F4ZG00

# Optional maintenance flag for direct frontend commands. `./start_app.sh` sets this itself.
# PUBLIC_APP_MAINTENANCE_MODE=1

# Optional browser-auth origin for Tauri Android handoff when login must open a different origin.
# PUBLIC_BROWSER_AUTH_BASE_URL=https://your-hosted-frontend.example.com
# VITE_BROWSER_AUTH_BASE_URL=https://your-hosted-frontend.example.com
