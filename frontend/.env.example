# Frontend env for local development and static builds.
# `./scripts/link_shared_env.sh` copies this file to `~/.config/dastill/frontend.env`.
# `VITE_` and `PUBLIC_` values are exposed to browser code by Vite/SvelteKit.

# Backend URL the Vite dev server proxies `/api` to.
VITE_API_BASE=http://localhost:3544

# Backend API base URL for hosted static builds. Leave empty locally to use the Vite proxy.
PUBLIC_API_BASE=http://localhost:3544

# Firebase Web API key from Firebase project settings.
PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key

# Firebase Auth domain for browser sign-in.
PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com

# Firebase project id used by the frontend Firebase client.
PUBLIC_FIREBASE_PROJECT_ID=your-project-id

# Optional Firebase Auth emulator host for local auth tests.
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
