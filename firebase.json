{
  "auth": {
    "providers": {
      "anonymous": true,
      "googleSignIn": {
        "oAuthBrandDisplayName": "dAstIll",
        "supportEmail": "thorben.woelk@gmail.com"
      }
    }
  },
  "emulators": {
    "auth": {
      "port": 9099
    }
  },
  "hosting": [
    {
      "target": "app",
      "public": "frontend/build",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "redirects": [
        {
          "source": "/docs",
          "destination": "https://dastill-docs.web.app",
          "type": 301
        },
        {
          "source": "/docs/",
          "destination": "https://dastill-docs.web.app",
          "type": 301
        },
        {
          "source": "/docs/:path*",
          "destination": "https://dastill-docs.web.app/:path",
          "type": 301
        }
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "/_app/immutable/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "/index.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        }
      ]
    },
    {
      "target": "docs",
      "public": "docs/.vitepress/dist",
      "cleanUrls": true,
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "headers": [
        {
          "source": "/assets/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "**/*.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        }
      ]
    }
  ]
}
