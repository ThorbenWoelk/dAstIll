# Backend env for local development.
# `./scripts/link_shared_env.sh` copies this file to `~/.config/dastill/backend.env`.
# Shell variables win over `backend/.env`; `backend/.env` wins over the shared file.

# Shell-only local app controls. Set these in your shell; startup scripts read them before env files.
# DASTILL_ENV_DIR=/Users/you/.config/dastill
# FRONTEND_PORT=3543
# BACKEND_PORT=3544
# DOCS_PORT=4173
# LOCAL_APP_MAINTENANCE_MODE=1
# START_APP_MOBILE=1
# START_APP_SKIP_MOBILE=1
# START_APP_ANDROID_AVD=Pixel_8_API_35
# JAVA_HOME=/Applications/Android Studio.app/Contents/jbr/Contents/Home
# ANDROID_HOME=/Users/you/Library/Android/sdk
# NDK_HOME=/Users/you/Library/Android/sdk/ndk/28.2.13676358

# Optional helper launcher override.
# FRONTEND_URL=http://localhost:3543

# Port used when running the backend binary directly. `./start_app.sh` sets this itself.
# PORT=3544

# Optional: force the local libSQL/FTS cache directory. Leave unset for a per-worktree temp path.
# DASTILL_LIBSQL_DIR=/tmp/dastill-search-index

# Firebase/GCP project id used for Firebase token validation and project-scoped API keys.
GCP_PROJECT_ID=your-gcp-project-id
# Optional aliases accepted by the backend when `GCP_PROJECT_ID` is unset.
# FIREBASE_PROJECT_ID=your-gcp-project-id
# PUBLIC_FIREBASE_PROJECT_ID=your-gcp-project-id
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# AWS region for S3, S3 Vectors, and Polly.
AWS_REGION=eu-central-1

# Canonical app data bucket.
S3_DATA_BUCKET=dastill-data-eu-central-1

# S3 Vectors bucket used for semantic search embeddings.
S3_VECTOR_BUCKET=dastill-vectors

# S3 Vectors index name. Defaults to `search-chunks` when unset.
S3_VECTOR_INDEX=search-chunks

# Preferred local AWS setup: point the SDK at machine-local credentials outside the repo.
# AWS_SHARED_CREDENTIALS_FILE=/Users/you/.config/dastill/aws/credentials
# AWS_CONFIG_FILE=/Users/you/.config/dastill/aws/config

# Optional AWS profile names for local diagnostics and AWS SDK fallback behavior.
# AWS_PROFILE=default
# AWS_DEFAULT_PROFILE=default

# Fallback local AWS setup: inline credentials. Avoid temporary session values for long-lived dev.
# AWS_ACCESS_KEY_ID=your-aws-access-key-id
# AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
# AWS_SESSION_TOKEN=your-temporary-session-token

# Production Cloud Run AWS federation. Terraform normally owns these values.
# AWS_ROLE_ARN=arn:aws:iam::123456789012:role/dastill-gcp-backend
# AWS_WIF_AUDIENCE=backend-service-account-unique-id

# Optional ADC file. Startup clears this when the path points at a missing file.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Optional local S3-compatible endpoints for MinIO or LocalStack.
# S3_ENDPOINT_URL=http://localhost:9000
# S3_VECTOR_ENDPOINT_URL=http://localhost:9001

# Trusted first-party proxy token for internal/proxy-auth requests.
BACKEND_PROXY_TOKEN=local-dev-backend-proxy-token

# Browser origins accepted by the backend CORS layer.
BACKEND_CORS_ALLOWED_ORIGINS=http://localhost:3543,http://127.0.0.1:3543,http://tauri.localhost,https://tauri.localhost,tauri://localhost

# Comma-separated sources seeded for a new local library.
DEFAULT_SEEDED_CHANNEL_IDS=UCbRP3c757lWg9M-U7TyEkXA,podcast:rss:https-feeds-simplecast-com-6hkohngs
# Legacy single-source fallback. Prefer `DEFAULT_SEEDED_CHANNEL_IDS`.
# DEFAULT_SEEDED_CHANNEL_ID=UCbRP3c757lWg9M-U7TyEkXA

# Optional operator email allowlist for local accounts that need the backend `operator` role.
# OPERATOR_EMAIL_ALLOWLIST=you@example.com

# Rolling 60-second per-client request limits. Defaults: 600 baseline, 120 expensive.
# BASELINE_RATE_LIMIT_PER_MINUTE=600
# EXPENSIVE_RATE_LIMIT_PER_MINUTE=120

# Anonymous chat message quota per visitor. Default: 30.
# ANONYMOUS_CHAT_QUOTA=30

# Worker idle gate. Background workers pause after this many seconds without user activity.
# USER_IDLE_TIMEOUT_SECS=300

# YouTube Data API key for YouTube source discovery and transcript fallback checks.
YOUTUBE_API_KEY=your-youtube-api-key

# OpenAlex API key for authenticated literature search. `OPENALEX_API_KEY` is accepted as fallback.
OPEN_ALEX_API_KEY=your-openalex-api-key
# OPENALEX_API_KEY=your-openalex-api-key

# Ollama endpoint. Local Ollama defaults to this URL.
OLLAMA_URL=http://localhost:11434

# Required when `OLLAMA_URL` points at a remote/cloud endpoint.
OLLAMA_API_KEY=your-ollama-api-key

# Primary summary generation and transcript-cleaning model.
OLLAMA_SUMMARY_MODEL=glm-5.1:cloud

# Optional local fallback when the primary summarizer is cloud-backed and rate-limited.
OLLAMA_FALLBACK_MODEL=gemma3:27b

# Default chat model. Falls back to the summary model when unset.
OLLAMA_DEFAULT_CHAT_MODEL=glm-5.1:cloud

# Cloud cooldown after model rate-limit responses. Defaults to the backend cooldown constant.
# OLLAMA_CLOUD_COOLDOWN_SECS=86400

# Cloud-backed summary evaluator. Must differ from the summary model and satisfy evaluator policy.
SUMMARY_EVALUATOR_MODEL=gemma4:31b-cloud

# Ignored legacy key. Summary evaluation is cloud-only.
# SUMMARY_EVALUATOR_FALLBACK_MODEL=

# Enables semantic search. Debug builds default on; release builds default off.
SEARCH_SEMANTIC_ENABLED=true

# Embedding model for semantic chunk/query embeddings. Required when semantic search is enabled.
OLLAMA_EMBEDDING_MODEL=embeddinggemma:latest

# Allows the search worker to create the ANN vector index. Keep false for local safety.
SEARCH_AUTO_CREATE_VECTOR_INDEX=false

# Optional short-query HyDE generation model for hybrid search.
# SEARCH_HYDE_MODEL=glm-5.1:cloud

# Optional cross-encoder reranker model for hybrid search.
# SEARCH_RERANK_MODEL=bge-reranker-v2-m3

# Enables multi-pass chat retrieval. Defaults to true.
# CHAT_MULTI_PASS_ENABLED=true

# Optional guardrail model and comma-separated prompt filters for chat input checks.
# CHAT_GUARDRAIL_MODEL=glm-5.1:cloud
# CHAT_PROMPT_BLOCKLIST=ignore previous instructions,reveal system prompt
# CHAT_PROMPT_ALLOWLIST=security training,prompt injection examples

# summarize CLI path used for YouTube transcript extraction.
SUMMARIZE_PATH=/opt/homebrew/bin/summarize

# yt-dlp path used as a YouTube caption fallback. Defaults to `/usr/local/bin/yt-dlp`.
# YTDLP_PATH=/usr/local/bin/yt-dlp

# Optional Logfire token for backend tracing and AI pipeline events.
# LOGFIRE_TOKEN=your-logfire-token

# Optional local/free podcast ASR. Used when podcast RSS does not publish a transcript.
# LOCAL_ASR_ENABLED=true
# LOCAL_ASR_BASE_URL=http://127.0.0.1:5092/v1
# LOCAL_ASR_AUTH_MODE=api_key
# LOCAL_ASR_API_KEY=sk-no-key-required
# LOCAL_ASR_MODEL=whisper-base.en
# LOCAL_ASR_MAX_AUDIO_BYTES=262144000
# LOCAL_ASR_TIMEOUT_SECS=3600

# Optional local ASR helper overrides used by `./scripts/start_local_asr.sh`.
# LOCAL_ASR_HOST=127.0.0.1
# LOCAL_ASR_PORT=5092
# LOCAL_ASR_MODEL_PATH=/Users/you/.cache/dastill/asr/ggml-base.en.bin
# LOCAL_ASR_MODEL_URL=https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-base.en.bin

# Optional Databricks analytics sink. Set host, token, and warehouse id together.
# DATABRICKS_HOST=https://dbc-xxxxxxxx.cloud.databricks.com
# DATABRICKS_TOKEN=your-databricks-pat
# DATABRICKS_WAREHOUSE_ID=your-warehouse-id
# DATABRICKS_CATALOG=workspace
# DATABRICKS_SCHEMA=sandbox
# DATABRICKS_BRONZE_TABLE=bronze_app_events

# Optional Amazon Polly TTS for summary audio playback.
# POLLY_TTS_ENABLED=true
# POLLY_TTS_VOICE_ID=Joanna
# POLLY_TTS_ENGINE=neural
# POLLY_TTS_OUTPUT_FORMAT=mp3
# POLLY_TTS_SAMPLE_RATE=16000

# Legacy migration-script settings only. The backend runtime uses local libSQL now.
# TURSO_DB_URL=libsql://your-turso-database.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token

# Live Ollama tests only. Keep unset for normal test runs.
# RUN_LIVE_OLLAMA_TESTS=1

# Chat capability evaluation binary only.
# CHAT_EVAL_USER_ID=local-eval-user
# CHAT_EVAL_ROLE=operator
